{
  "name": "schdesktop",
  "version": "1.0.0",
  "description": "Modern Education Platform for Schools",
  "author": "Jaya krishna ",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "make-exe": "ng build --configuration desktop && electron-builder",
    "jay": "ng build && git add . && git commit -m \"Latest spread app update\" && git push origin main"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "build": {
    "appId": "com.school.schdesktop",
    "productName": "SchoolApp",
    "directories": {
      "output": "dist/desktop-pkg"
    },
    "win": {
      "target": "portable",
      "icon": "public/icon.png"
    },
    "files": [
      "dist/schdesktop/**/*",
      "main.js",
      "package.json"
    ]
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
